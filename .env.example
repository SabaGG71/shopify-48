# 48 Hour Rebuild. Copy to .env.local for local work; set the same names in Vercel.
# Prices, links and videos are NOT env vars by default: Kent sets them in /admin -> Settings
# (stored in the database, no deploy). Any config key can also be set here as a fallback,
# e.g. PRICE_DISPLAY, RESERVE_URL, BOOKING_URL, VSL_URL, KENT_TEXT_NUMBER.

# Public site address, no trailing slash. Used in links we send (intake link, admin links).
SITE_URL=https://your-domain.com

# Neon Postgres (Drizzle). Server only. Tables: run `npm run db:migrate` once per database.
DATABASE_URL=

# Vercel Blob for intake uploads (Vercel dashboard > Storage > Blob > connect to the project adds this).
BLOB_READ_WRITE_TOKEN=

# Admin page sign-in (/admin). Without ADMIN_PASSWORD, /admin is closed in production.
# ADMIN_USERNAME is optional and defaults to kent2026.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Alerts to Kent. Kent wants email (Resend). Twilio is optional (texts, and the no-show rebook text).
KENT_ALERT_EMAIL=
KENT_ALERT_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (intake link after payment, Kent's alert emails). Verified sending domain needed.
RESEND_API_KEY=
EMAIL_FROM=LocalEyes <hello@localeyesgrowth.com>
EMAIL_REPLY_TO=hello@localeyesgrowth.com

# Google Sheet copy of every lead (one row per application, updated as they move along).
# Paste docs/google-sheet-sync.gs into the sheet's Apps Script, deploy it as a web app,
# and put its /exec URL and the secret phrase here. Leave empty to turn the sync off.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Stripe: webhook for checkout.session.completed and checkout.session.async_payment_succeeded
# -> https://<site>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Optional: lets /reserved create the intake instantly instead of waiting for the webhook.
STRIPE_SECRET_KEY=
# Only count payments from the 48 Hour Rebuild Payment Link (plink_...), ignore the rest of the account.
STRIPE_PAYMENT_LINK_ID=

# Calendly: personal access token (reads the booked time, creates the webhook) and the webhook
# signing key printed by scripts/calendly-webhook.mjs (new booking, cancel, no-show).
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# Meta pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Set while testing in Events Manager, remove after.
META_TEST_EVENT_CODE=
# META_GRAPH_VERSION=v24.0
